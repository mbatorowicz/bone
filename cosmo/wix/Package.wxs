<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Bone Cosmo"
      Manufacturer="mbatorowicz"
      Version="0.1.2"
      UpgradeCode="a7c3e1f0-4b2d-4e8a-9c11-b01e00000001"
      Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="Nowsza wersja Bone Cosmo jest już zainstalowana." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Bone Cosmo">
        <Component Id="AppExe" Guid="a7c3e1f0-4b2d-4e8a-9c11-b01e00000002">
          <File Id="BoneCosmoExe" Source="!(bindpath.app)\BoneCosmo.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="a7c3e1f0-4b2d-4e8a-9c11-b01e00000003">
        <Shortcut
            Id="StartMenuBoneCosmo"
            Name="Bone Cosmo"
            Description="ΛCDM — Planck 2018"
            Target="[INSTALLFOLDER]BoneCosmo.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\mbatorowicz\BoneCosmo"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main" Title="Bone Cosmo" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
